# Copy values to the hosting provider environment; these placeholders are not auto-loaded.
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-strong-password-at-least-12-characters
COOKIE_SECURE=1
SHOW_DEMO_CREDENTIALS=0
FLASK_ENV=production

# Company legal master for GST simulation exports. Replace every demo value.
COMPANY_NAME=Replace With Legal Company Name
COMPANY_GSTIN=29ABCDE1234F1Z5
COMPANY_STATE=Karnataka
COMPANY_ADDRESS=Replace With Legal Business Address
COMPANY_PINCODE=570016
COMPANY_PHONE=
COMPANY_EMAIL=

# Generate separately and store as a deployment secret; never commit the key or database.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VENDOR_DATA_KEY=replace-with-a-generated-fernet-key

# Optional stable deployment generation ID (shared by all WSGI workers).
# UNIWORK_BOOT_ID=production-2026-10
# Optional persistent SQLite path; otherwise backend/instance/uniwork.sqlite3 is used.
# UNIWORK_DB=/opt/render/project/data/uniwork.sqlite3
